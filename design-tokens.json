{
    "$schema": "https://tokens.studio/schemas/tokens.json",
    "$themes": [
        {
            "id": "portfolio-light",
            "name": "Light",
            "selectedTokenSets": {
                "primitive": "enabled",
                "semantic/light": "enabled",
                "typography": "enabled",
                "spacing": "enabled",
                "radius": "enabled",
                "shadow/light": "enabled",
                "layout": "enabled"
            },
            "$figmaStyleReferences": {}
        },
        {
            "id": "portfolio-dark",
            "name": "Dark",
            "selectedTokenSets": {
                "primitive": "enabled",
                "semantic/dark": "enabled",
                "typography": "enabled",
                "spacing": "enabled",
                "radius": "enabled",
                "shadow/dark": "enabled",
                "layout": "enabled"
            },
            "$figmaStyleReferences": {}
        }
    ],
    "primitive": {
        "color": {
            "blue": {
                "300": {
                    "$type": "color",
                    "$value": "#93a8ff",
                    "$description": "Dark --color-primary"
                },
                "400": {
                    "$type": "color",
                    "$value": "#6b7fff",
                    "$description": "Dark --color-primary-dark"
                },
                "500": {
                    "$type": "color",
                    "$value": "#2456ff",
                    "$description": "Light --color-primary"
                },
                "600": {
                    "$type": "color",
                    "$value": "#183fd1",
                    "$description": "Light --color-primary-dark"
                }
            },
            "pink": {
                "300": {
                    "$type": "color",
                    "$value": "#ff7eb3",
                    "$description": "Dark --color-accent-hot"
                },
                "500": {
                    "$type": "color",
                    "$value": "#ff5c8d",
                    "$description": "Light --color-accent-hot"
                }
            },
            "mint": {
                "300": {
                    "$type": "color",
                    "$value": "#3ee8c5",
                    "$description": "Dark --color-accent-mint"
                },
                "500": {
                    "$type": "color",
                    "$value": "#0ecf9b",
                    "$description": "Light --color-accent-mint"
                }
            },
            "neutral": {
                "0": {
                    "$type": "color",
                    "$value": "#ffffff",
                    "$description": "White / light surface"
                },
                "50": {
                    "$type": "color",
                    "$value": "#f8fafc",
                    "$description": "Light gradient start"
                },
                "75": {
                    "$type": "color",
                    "$value": "#f4f6fb",
                    "$description": "Light --color-bg"
                },
                "100": {
                    "$type": "color",
                    "$value": "#eef3fb",
                    "$description": "Light gradient surface end"
                },
                "150": {
                    "$type": "color",
                    "$value": "#e9eef6",
                    "$description": "Light --color-surface-strong"
                },
                "200": {
                    "$type": "color",
                    "$value": "#e8eef8",
                    "$description": "Light --gradient-noise midpoint"
                },
                "300": {
                    "$type": "color",
                    "$value": "#e2eaf5",
                    "$description": "Light --shadow-glow base"
                },
                "400": {
                    "$type": "color",
                    "$value": "#c9d5e6",
                    "$description": "Light --color-border"
                },
                "500": {
                    "$type": "color",
                    "$value": "#4a5d82",
                    "$description": "Light --color-text-muted"
                },
                "700": {
                    "$type": "color",
                    "$value": "#152038",
                    "$description": "Light --shadow-soft base"
                },
                "800": {
                    "$type": "color",
                    "$value": "#0a0f1a",
                    "$description": "Light --color-text"
                },
                "900": {
                    "$type": "color",
                    "$value": "#020617",
                    "$description": "Overlay / dark shadow base"
                },
                "950": {
                    "$type": "color",
                    "$value": "#050810",
                    "$description": "Dark --color-bg"
                }
            },
            "slate": {
                "50": {
                    "$type": "color",
                    "$value": "#f4f7ff",
                    "$description": "Dark --color-text"
                },
                "300": {
                    "$type": "color",
                    "$value": "#9fb1d6",
                    "$description": "Dark --color-text-muted"
                },
                "400": {
                    "$type": "color",
                    "$value": "#40506c",
                    "$description": "Dark --shadow-glow base"
                },
                "500": {
                    "$type": "color",
                    "$value": "#2a3f63",
                    "$description": "Dark --color-border"
                },
                "600": {
                    "$type": "color",
                    "$value": "#141d32",
                    "$description": "Dark --color-surface-strong"
                },
                "650": {
                    "$type": "color",
                    "$value": "#122345",
                    "$description": "Dark glass base"
                },
                "700": {
                    "$type": "color",
                    "$value": "#121d34",
                    "$description": "Dark gradient surface end"
                },
                "750": {
                    "$type": "color",
                    "$value": "#0d1424",
                    "$description": "Dark --color-surface"
                },
                "800": {
                    "$type": "color",
                    "$value": "#0a1222",
                    "$description": "Dark --gradient-noise end"
                }
            },
            "purple": {
                "300": {
                    "$type": "color",
                    "$value": "#c084fc",
                    "$description": "Dark --gradient-accent midpoint"
                },
                "500": {
                    "$type": "color",
                    "$value": "#7038cc",
                    "$description": "Light --gradient-accent midpoint"
                }
            },
            "cyan": {
                "300": {
                    "$type": "color",
                    "$value": "#38bdf8",
                    "$description": "Dark --gradient-accent end"
                },
                "600": {
                    "$type": "color",
                    "$value": "#087ea4",
                    "$description": "Light --gradient-accent end"
                }
            },
            "alpha": {
                "overlayLight": {
                    "$type": "color",
                    "$value": "rgba(2, 6, 23, 0.64)",
                    "$description": "Resolved from color-mix(in srgb, #020617 64%, transparent)"
                },
                "overlayDark": {
                    "$type": "color",
                    "$value": "rgba(2, 6, 23, 0.74)",
                    "$description": "Resolved from color-mix(in srgb, #020617 74%, transparent)"
                },
                "glassLight": {
                    "$type": "color",
                    "$value": "rgba(255, 255, 255, 0.76)",
                    "$description": "Resolved from color-mix(in srgb, #ffffff 76%, transparent)"
                },
                "glassLightStrong": {
                    "$type": "color",
                    "$value": "rgba(255, 255, 255, 0.88)",
                    "$description": "Resolved from color-mix(in srgb, #ffffff 88%, transparent)"
                },
                "glassDark": {
                    "$type": "color",
                    "$value": "rgba(18, 35, 69, 0.72)",
                    "$description": "Resolved from color-mix(in srgb, #122345 72%, transparent)"
                },
                "glassDarkStrong": {
                    "$type": "color",
                    "$value": "rgba(18, 35, 69, 0.86)",
                    "$description": "Resolved from color-mix(in srgb, #122345 86%, transparent)"
                }
            }
        }
    },
    "palette": {
        "$description": "Editorial blue theme — synced to assets/style/abstracts/_tokens.scss via npm run tokens:sync",
        "grayscale": {
            "0": { "$type": "color", "$value": "#fbfdff", "$cssVar": "--grayscale-0" },
            "50": { "$type": "color", "$value": "#f2f6fb", "$cssVar": "--grayscale-50" },
            "100": { "$type": "color", "$value": "#e7eef7", "$cssVar": "--grayscale-100" },
            "200": { "$type": "color", "$value": "#d4deec", "$cssVar": "--grayscale-200" },
            "300": { "$type": "color", "$value": "#b7c5d8", "$cssVar": "--grayscale-300" },
            "400": { "$type": "color", "$value": "#899ab2", "$cssVar": "--grayscale-400" },
            "500": { "$type": "color", "$value": "#66758d", "$cssVar": "--grayscale-500" },
            "600": { "$type": "color", "$value": "#48566f", "$cssVar": "--grayscale-600" },
            "700": { "$type": "color", "$value": "#2f3a50", "$cssVar": "--grayscale-700" },
            "800": { "$type": "color", "$value": "#1c2536", "$cssVar": "--grayscale-800" },
            "900": { "$type": "color", "$value": "#101827", "$cssVar": "--grayscale-900" },
            "950": { "$type": "color", "$value": "#08101d", "$cssVar": "--grayscale-950" }
        },
        "primary": {
            "50": { "$type": "color", "$value": "#edf5ff", "$cssVar": "--primary-50" },
            "100": { "$type": "color", "$value": "#d6e8fb", "$cssVar": "--primary-100" },
            "200": { "$type": "color", "$value": "#adcdec", "$cssVar": "--primary-200" },
            "300": { "$type": "color", "$value": "#7eaedb", "$cssVar": "--primary-300" },
            "400": { "$type": "color", "$value": "#508cc4", "$cssVar": "--primary-400" },
            "500": { "$type": "color", "$value": "#2f6fa7", "$cssVar": "--primary-500" },
            "600": { "$type": "color", "$value": "#255987", "$cssVar": "--primary-600" },
            "700": { "$type": "color", "$value": "#1d4568", "$cssVar": "--primary-700" },
            "800": { "$type": "color", "$value": "#17324c", "$cssVar": "--primary-800" },
            "900": { "$type": "color", "$value": "#102338", "$cssVar": "--primary-900" }
        },
        "accent": {
            "hot": { "$type": "color", "$value": "#476f9f", "$cssVar": "--accent-hot", "$description": "Editorial accent (not pink in production)" },
            "mint": { "$type": "color", "$value": "#7898b8", "$cssVar": "--accent-mint", "$description": "Editorial accent (not mint green in production)" }
        },
        "state": {
            "error": { "$type": "color", "$value": "#dc2626", "$cssVar": "--state-error" },
            "success": { "$type": "color", "$value": "#0f9f6e", "$cssVar": "--state-success" },
            "warning": { "$type": "color", "$value": "#d97706", "$cssVar": "--state-warning" }
        }
    },
    "semantic/light": {
        "color": {
            "brand": {
                "primary": {
                    "$type": "color",
                    "$value": "{palette.primary.600}",
                    "$description": "--color-primary"
                },
                "primaryDark": {
                    "$type": "color",
                    "$value": "{palette.primary.700}",
                    "$description": "--color-primary-dark"
                }
            },
            "accent": {
                "hot": {
                    "$type": "color",
                    "$value": "{palette.accent.hot}",
                    "$description": "--color-accent-hot"
                },
                "mint": {
                    "$type": "color",
                    "$value": "{palette.accent.mint}",
                    "$description": "--color-accent-mint"
                }
            },
            "background": {
                "default": {
                    "$type": "color",
                    "$value": "{palette.grayscale.100}",
                    "$description": "--color-bg"
                },
                "surface": {
                    "$type": "color",
                    "$value": "{palette.grayscale.0}",
                    "$description": "--color-surface"
                },
                "surfaceStrong": {
                    "$type": "color",
                    "$value": "{palette.grayscale.200}",
                    "$description": "--color-surface-strong"
                },
                "glass": {
                    "$type": "color",
                    "$value": "{primitive.color.alpha.glassLight}",
                    "$description": "--color-glass-2"
                },
                "glassStrong": {
                    "$type": "color",
                    "$value": "{primitive.color.alpha.glassLightStrong}",
                    "$description": "--color-glass-2-strong"
                },
                "overlay": {
                    "$type": "color",
                    "$value": "{primitive.color.alpha.overlayLight}",
                    "$description": "--color-overlay"
                }
            },
            "text": {
                "default": {
                    "$type": "color",
                    "$value": "{palette.grayscale.900}",
                    "$description": "--color-text"
                },
                "muted": {
                    "$type": "color",
                    "$value": "{palette.grayscale.700}",
                    "$description": "--color-text-muted"
                },
                "onAccent": {
                    "$type": "color",
                    "$value": "{palette.grayscale.0}",
                    "$description": "--color-on-accent"
                }
            },
            "border": {
                "default": {
                    "$type": "color",
                    "$value": "{palette.grayscale.300}",
                    "$description": "--color-border"
                }
            }
        },
        "gradient": {
            "accent": {
                "$type": "asset",
                "$value": "linear-gradient(118deg, #7eaedb 0%, #2f6fa7 52%, #17324c 100%)",
                "$description": "--gradient-accent (Figma sample; runtime uses var() chain)"
            },
            "surface": {
                "$type": "asset",
                "$value": "linear-gradient(168deg, #fbfdff 0%, #e7eef7 56%, #d4deec 100%)",
                "$description": "--gradient-surface"
            },
            "noise": {
                "$type": "asset",
                "$value": "linear-gradient(185deg, #fbfdff 0%, #ecf3fb 48%, #dfe8f4 100%)",
                "$description": "--gradient-noise"
            }
        }
    },
    "semantic/dark": {
        "color": {
            "brand": {
                "primary": {
                    "$type": "color",
                    "$value": "{primitive.color.blue.300}",
                    "$description": "--color-primary"
                },
                "primaryDark": {
                    "$type": "color",
                    "$value": "{primitive.color.blue.400}",
                    "$description": "--color-primary-dark"
                }
            },
            "accent": {
                "hot": {
                    "$type": "color",
                    "$value": "{primitive.color.pink.300}",
                    "$description": "--color-accent-hot"
                },
                "mint": {
                    "$type": "color",
                    "$value": "{primitive.color.mint.300}",
                    "$description": "--color-accent-mint"
                }
            },
            "background": {
                "default": {
                    "$type": "color",
                    "$value": "{primitive.color.neutral.950}",
                    "$description": "--color-bg"
                },
                "surface": {
                    "$type": "color",
                    "$value": "{primitive.color.slate.750}",
                    "$description": "--color-surface"
                },
                "surfaceStrong": {
                    "$type": "color",
                    "$value": "{primitive.color.slate.600}",
                    "$description": "--color-surface-strong"
                },
                "glass": {
                    "$type": "color",
                    "$value": "{primitive.color.alpha.glassDark}",
                    "$description": "--color-glass-2"
                },
                "glassStrong": {
                    "$type": "color",
                    "$value": "{primitive.color.alpha.glassDarkStrong}",
                    "$description": "--color-glass-2-strong"
                },
                "overlay": {
                    "$type": "color",
                    "$value": "{primitive.color.alpha.overlayDark}",
                    "$description": "--color-overlay"
                }
            },
            "text": {
                "default": {
                    "$type": "color",
                    "$value": "{primitive.color.slate.50}",
                    "$description": "--color-text"
                },
                "muted": {
                    "$type": "color",
                    "$value": "{primitive.color.slate.300}",
                    "$description": "--color-text-muted"
                },
                "onAccent": {
                    "$type": "color",
                    "$value": "#06111f",
                    "$description": "--color-on-accent"
                }
            },
            "border": {
                "default": {
                    "$type": "color",
                    "$value": "{primitive.color.slate.500}",
                    "$description": "--color-border"
                }
            }
        },
        "gradient": {
            "accent": {
                "$type": "asset",
                "$value": "linear-gradient(118deg, #93a8ff 0%, #c084fc 52%, #38bdf8 100%)",
                "$description": "--gradient-accent"
            },
            "surface": {
                "$type": "asset",
                "$value": "linear-gradient(168deg, #0d1424 0%, #121d34 100%)",
                "$description": "--gradient-surface"
            },
            "noise": {
                "$type": "asset",
                "$value": "linear-gradient(185deg, #050810 0%, #0d1424 55%, #0a1222 100%)",
                "$description": "--gradient-noise"
            }
        }
    },
    "typography": {
        "fontFamily": {
            "display": {
                "$type": "fontFamilies",
                "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
                "$description": "--font-display"
            },
            "body": {
                "$type": "fontFamilies",
                "$value": "-apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
                "$description": "--font-body"
            },
            "mono": {
                "$type": "fontFamilies",
                "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
                "$description": "--font-mono"
            },
            "pretendard": {
                "$type": "fontFamilies",
                "$value": "Pretendard, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
                "$description": "--font-pretendard"
            }
        },
        "fontSize": {
            "2xs": {
                "$type": "fontSizes",
                "$value": "0.875rem",
                "$description": "--font-size-2xs (alias of xs)"
            },
            "xs": {
                "$type": "fontSizes",
                "$value": "0.875rem",
                "$description": "--font-size-xs (14px UI minimum)"
            },
            "sm": {
                "$type": "fontSizes",
                "$value": "0.9375rem",
                "$description": "--font-size-sm"
            },
            "md": {
                "$type": "fontSizes",
                "$value": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
                "$description": "--font-size-md (16px+ body)"
            },
            "lg": {
                "$type": "fontSizes",
                "$value": "clamp(1rem, 0.96rem + 0.32vw, 1.16rem)",
                "$description": "--font-size-lg"
            },
            "xl": {
                "$type": "fontSizes",
                "$value": "clamp(1.12rem, 1rem + 0.8vw, 1.42rem)",
                "$description": "--font-size-xl"
            },
            "sectionTitle": {
                "$type": "fontSizes",
                "$value": "{typography.fontSize.display4}",
                "$description": "--font-size-section-title (alias of Display-4)"
            },
            "hero": {
                "$type": "fontSizes",
                "$value": "{typography.fontSize.display1}",
                "$description": "--font-size-hero (alias of Display-1)"
            },
            "heroCard": {
                "$type": "fontSizes",
                "$value": "{typography.fontSize.display3}",
                "$description": "--font-size-hero-card (alias of Display-3)"
            },
            "displaySoft": {
                "$type": "fontSizes",
                "$value": "{typography.fontSize.display3}",
                "$description": "--font-size-display-soft (alias of Display-3)"
            },
            "contact": {
                "$type": "fontSizes",
                "$value": "clamp(2.5rem, 9vw, 9.5rem)",
                "$description": "--font-size-contact"
            },
            "counter": {
                "$type": "fontSizes",
                "$value": "{typography.fontSize.display5}",
                "$description": "--font-size-counter (alias of Display-5)"
            },
            "display1": {
                "$type": "fontSizes",
                "$value": "clamp(4rem, 7.5vw, 8.5rem)",
                "$description": "--font-size-display-1 / PC Display-1"
            },
            "display2": {
                "$type": "fontSizes",
                "$value": "clamp(3.4rem, 6.2vw, 6.75rem)",
                "$description": "--font-size-display-2 / large editorial display"
            },
            "display3": {
                "$type": "fontSizes",
                "$value": "clamp(2.5rem, 5vw, 5.25rem)",
                "$description": "--font-size-display-3 / strong section display"
            },
            "display4": {
                "$type": "fontSizes",
                "$value": "clamp(1.9rem, 3.2vw, 3.05rem)",
                "$description": "--font-size-display-4 / section title"
            },
            "display5": {
                "$type": "fontSizes",
                "$value": "clamp(1.55rem, 2.8vw, 2.35rem)",
                "$description": "--font-size-display-5 / feature title"
            },
            "display6": {
                "$type": "fontSizes",
                "$value": "clamp(1.35rem, 2.4vw, 2rem)",
                "$description": "--font-size-display-6 / compact display title"
            },
            "title1": {
                "$type": "fontSizes",
                "$value": "clamp(1.12rem, 1rem + 0.8vw, 1.42rem)",
                "$description": "--font-size-title-1"
            },
            "title2": {
                "$type": "fontSizes",
                "$value": "clamp(1rem, 0.96rem + 0.32vw, 1.16rem)",
                "$description": "--font-size-title-2"
            },
            "title3": {
                "$type": "fontSizes",
                "$value": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
                "$description": "--font-size-title-3"
            },
            "body1": {
                "$type": "fontSizes",
                "$value": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)",
                "$description": "--font-size-body-1"
            },
            "body2": {
                "$type": "fontSizes",
                "$value": "0.9375rem",
                "$description": "--font-size-body-2"
            },
            "label": {
                "$type": "fontSizes",
                "$value": "0.875rem",
                "$description": "--font-size-label (14px UI label)"
            },
            "chip": {
                "$type": "fontSizes",
                "$value": "0.75rem",
                "$description": "--font-size-chip (12px minimum chip)"
            }
        },
        "lineHeight": {
            "tight": {
                "$type": "lineHeights",
                "$value": "1.05",
                "$description": "--line-height-tight"
            },
            "display": {
                "$type": "lineHeights",
                "$value": "1.12",
                "$description": "--line-height-display"
            },
            "heading": {
                "$type": "lineHeights",
                "$value": "1.14",
                "$description": "--line-height-heading"
            },
            "title": {
                "$type": "lineHeights",
                "$value": "1.22",
                "$description": "--line-height-title"
            },
            "body": {
                "$type": "lineHeights",
                "$value": "1.72",
                "$description": "--line-height-body"
            },
            "ui": {
                "$type": "lineHeights",
                "$value": "1.2",
                "$description": "--line-height-ui"
            }
        },
        "fontWeight": {
            "regular": {
                "$type": "fontWeights",
                "$value": "500",
                "$description": "--font-weight-regular"
            },
            "medium": {
                "$type": "fontWeights",
                "$value": "650",
                "$description": "--font-weight-medium"
            },
            "semibold": {
                "$type": "fontWeights",
                "$value": "720",
                "$description": "--font-weight-semibold"
            },
            "bold": {
                "$type": "fontWeights",
                "$value": "760",
                "$description": "--font-weight-bold"
            },
            "black": {
                "$type": "fontWeights",
                "$value": "900",
                "$description": "--font-weight-black"
            }
        },
        "letterSpacing": {
            "tight": {
                "$type": "letterSpacing",
                "$value": "-0.04em",
                "$description": "--tracking-tight"
            },
            "heading": {
                "$type": "letterSpacing",
                "$value": "-0.035em",
                "$description": "--tracking-heading"
            },
            "ui": {
                "$type": "letterSpacing",
                "$value": "0.02em",
                "$description": "--tracking-ui"
            },
